---
import { getCollection } from 'astro:content';
import TestimonialCard from './TestimonialCard.astro';

interface Props {
  id?: string;
}

const { id = 'testimonials' } = Astro.props;

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section {id}>
  <div class="container">
    <h2 class="section-title">What our alumni say</h2>
    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <TestimonialCard
          quote={t.data.quote}
          author={t.data.author}
          role={t.data.role}
          avatar={t.data.avatar}
        />
      ))}
    </div>
  </div>
</section>

<style>
  section {
    background: transparent;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 24px;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  @media (max-width: 860px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
