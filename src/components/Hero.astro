---
import wireframeBg from '~/assets/brand/dodeca-wireframe.png';

interface Props {
  headline: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
}

const { headline, subtitle, ctaLabel, ctaHref } = Astro.props;
const headlineHtml = headline.replace(/\n/g, '<br/>');
---

<section class="hero" style={`background-image:url(${wireframeBg.src})`}>
  <div class="hero-inner">
    <div class="hero-content">
      <h1 set:html={headlineHtml}></h1>
      <p>{subtitle}</p>
      <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  /* Hero is left-aligned: text occupies the left half, the body-BG
   * (dodeca-wireframe.png, positioned center/right) shows through
   * on the right. Mobile: text becomes full-width and centered. */
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 80px 0;
    /* The wireframe-dodecahedron is anchored right; text reads left.
     * Section bg sits on top of the body's star-field. */
    background-repeat: no-repeat;
    background-size: cover;
    background-position: right center;
  }
  .hero-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 28px;
    width: 100%;
  }
  .hero-content {
    max-width: 560px;
    position: relative;
    z-index: 1;
    text-align: left;
  }
  .hero-content h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.1;
    color: var(--white);
    margin-bottom: 28px;
    font-weight: 700;
  }
  .hero-content p {
    font-size: clamp(15px, 1.6vw, 18px);
    color: var(--text);
    line-height: 1.75;
    max-width: 480px;
    margin: 0 0 40px;
  }
  .btn-primary {
    display: inline-block;
    padding: 14px 34px;
    background: linear-gradient(90deg, var(--magenta) 0%, var(--violet) 100%);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    border-radius: 999px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }
  @media (max-width: 860px) {
    .hero {
      min-height: 80vh;
      padding: 60px 0;
    }
    .hero-content {
      max-width: 100%;
      text-align: center;
    }
    .hero-content p {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
