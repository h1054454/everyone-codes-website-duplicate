---
import { getCollection } from 'astro:content';
import TeamCard from './TeamCard.astro';

interface Props {
  id?: string;
}

const { id = 'team' } = Astro.props;

const members = (await getCollection('team', (m) => m.data.active)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section {id}>
  <div class="container">
    <h2 class="section-title">Our Team</h2>
    <div class="team-grid">
      {members.map((m) => (
        <TeamCard name={m.data.name} role={m.data.role} photo={m.data.photo} />
      ))}
    </div>
  </div>
</section>

<style>
  section {
    background: transparent;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 24px;
  }
  /* Flex layout matching Squarespace live: wrap, 24px gap, justify center
   * so the trailing row centers nicely when the count doesn't fit a full row. */
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 48px;
  }
  .team-grid > * {
    flex: 0 1 232px;
  }
  @media (max-width: 540px) {
    .team-grid > * {
      flex: 0 1 calc(50% - 12px);
    }
  }
</style>
