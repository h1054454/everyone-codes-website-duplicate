---
import { getCollection } from 'astro:content';

interface Props {
  id?: string;
}

const { id = 'career' } = Astro.props;

const jobs = (await getCollection('jobs', (j) => j.data.active)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section {id}>
  <div class="container">
    <h2 class="section-title">Career</h2>
    <p class="section-intro">
      We are continuously seeking to expand our team with innovative, compassionate
      individuals who share our vision and values.
    </p>

    <div class="career-cards">
      {jobs.map((job) => (
        <article class="job-card">
          <h3>{job.data.title}</h3>
          <div class="job-card-divider"></div>
          <p>{job.data.description}</p>
          <p class="job-start">{job.data.start_date}</p>
          <a href={job.data.link} target="_blank" rel="noopener" class="btn-job">View →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Career section is transparent — body-bg (star-field) shows through,
   * matching the live site which uses image-e3b82.jpeg (stars only). */
  section {
    background: transparent;
    text-align: center;
    padding: 100px 24px;
  }
  .section-title {
    font-size: clamp(26px, 4vw, 42px);
    margin-bottom: 16px;
    color: var(--white);
  }
  .section-intro {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .career-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    margin-top: 52px;
  }
  .job-card {
    background: #1a1340;
    border-radius: 12px;
    border-left: 4px solid var(--lime);
    padding: 36px 32px 32px;
    max-width: 360px;
    width: 100%;
    text-align: left;
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }
  .job-card h3 {
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .job-card-divider {
    height: 3px;
    background: var(--lime);
    border-radius: 2px;
    margin-bottom: 22px;
    width: 100%;
  }
  .job-card p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 14px;
    text-align: left;
  }
  .job-card .job-start {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--white);
    margin-top: auto;
    margin-bottom: 28px;
  }
  .btn-job {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 36px;
    border: 2px solid var(--lime);
    color: var(--white);
    background: transparent;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    border-radius: 50px;
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
    align-self: flex-start;
  }
  .btn-job:hover,
  .btn-job:focus-visible {
    background: var(--lime);
    color: var(--bg);
  }
</style>
