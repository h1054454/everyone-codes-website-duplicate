---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  role: string;
  photo: ImageMetadata;
}

const { name, role, photo } = Astro.props;
---

<article class="tm-card">
  <Image src={photo} alt={`Photo of ${name}`} class="tm-photo" width={232} height={232} />
  <div class="tm-info">
    <h3>{name}</h3>
    <span>{role}</span>
  </div>
</article>

<style>
  /* Transparent card – matches Squarespace live-site visual (no box, no border). */
  .tm-card {
    background: transparent;
    border: none;
    box-shadow: none;
    max-width: 344px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0 auto;
  }
  .tm-photo {
    display: block;
    width: 232px;
    height: 232px;
    object-fit: cover;
    object-position: top center;
    margin-bottom: 12px;
  }
  .tm-info {
    padding: 0;
  }
  .tm-info h3 {
    font-size: 20px;
    line-height: 1.3;
    color: var(--white);
    font-weight: 700;
    margin-bottom: 4px;
  }
  .tm-info span {
    font-size: 18px;
    line-height: 1.3;
    color: var(--white);
    font-weight: 400;
    font-family: var(--font-body);
  }
  @media (max-width: 540px) {
    .tm-photo {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }
</style>
