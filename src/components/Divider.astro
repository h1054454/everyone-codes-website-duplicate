---
import dividerImg from '~/assets/brand/divider-triple-long.svg';
---

<div class="divider" aria-hidden="true">
  <img src={dividerImg.src} alt="" />
</div>

<style>
  /* Full-width gradient divider (violet → pink → orange → cyan).
   * Matches the live site's triple-lines-we1e4.png (2100×57). */
  .divider {
    display: block;
    padding: 12px 0;
    overflow: hidden;
    line-height: 0;
  }
  .divider img {
    width: 100%;
    height: auto;
    max-height: 48px;
    display: block;
  }
</style>
