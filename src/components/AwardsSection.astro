---
import { getCollection } from 'astro:content';
import AwardBadge from './AwardBadge.astro';

interface Props {
  id?: string;
}

const { id = 'awards' } = Astro.props;

const awards = (await getCollection('awards')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section {id}>
  <div class="container">
    <h2 class="section-title">Prizes &amp; Awards</h2>
    <div class="awards-row">
      {awards.map((a) => (
        <AwardBadge name={a.data.name} logo={a.data.logo} url={a.data.url} />
      ))}
    </div>
  </div>
</section>

<style>
  section {
    background: transparent;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 24px;
  }
  .awards-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 36px 56px;
    margin-top: 48px;
    align-items: center;
  }
</style>
