---
import AwardBadge from './AwardBadge.astro';
import socialImpact from '~/assets/awards/social-impact.png';
import hr2017 from '~/assets/awards/hr-2017.png';
import ideasEurope from '~/assets/awards/ideas-europe.png';
import cocaCola from '~/assets/awards/coca-cola.png';

interface Props {
  id?: string;
}

const { id = 'awards' } = Astro.props;
---

<section {id}>
  <div class="container">
    <h2 class="section-title">Prizes &amp; Awards</h2>
    <div class="awards-row">
      <AwardBadge name="Social Impact Award" logo={socialImpact} url="https://socialimpactaward.net" />
      <AwardBadge name="HR Award 2017" logo={hr2017} url="https://leadersnet.at" />
      <AwardBadge name="Ideas from Europe" logo={ideasEurope} url="https://medium.com" />
      <AwardBadge name="Coca-Cola Get Active Social Business Award" logo={cocaCola} url="https://coca-cola-oesterreich.at" />
    </div>
  </div>
</section>

<style>
  section {
    background: transparent;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 24px;
  }
  .awards-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 36px 56px;
    margin-top: 48px;
    align-items: center;
  }
</style>
