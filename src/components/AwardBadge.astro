---
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  logo: ImageMetadata;
  url: string;
}

const { name, logo, url } = Astro.props;
---

<a href={url} target="_blank" rel="noopener" class="award-badge" aria-label={name}>
  <img src={logo.src} alt={name} loading="lazy" />
</a>

<style>
  .award-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 150px;
    text-align: center;
    transition: transform 0.2s;
  }
  .award-badge:hover,
  .award-badge:focus-visible {
    transform: translateY(-4px);
  }
  .award-badge img {
    height: 120px;
    width: auto;
  }
</style>
