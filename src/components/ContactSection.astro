---
interface Props {
  id?: string;
}

const { id = 'contact' } = Astro.props;
---

<section {id}>
  <div class="container">
    <h2 class="section-title">Contact us</h2>
    <p class="section-intro">
      Want to learn more about our programmes, partner with us, or hire our graduates?
      We'd love to hear from you.
    </p>

    <div class="contact-info">
      <a href="mailto:office@everyonecodes.io" class="contact-link">
        <span class="contact-icon" aria-hidden="true">✉</span>
        <span>office@everyonecodes.io</span>
      </a>
      <div class="contact-link">
        <span class="contact-icon" aria-hidden="true">📍</span>
        <span>Muthgasse 58/60, 1190 Vienna, Austria</span>
      </div>
    </div>

    <!--
      Live site has a Squarespace contact form here (Name / E-Mail / Message / Submit).
      Sprint B: integrate a form backend (Formspree / Formspark / serverless function).
      The header dropdown 'For Companies' already routes to /for-companies/work-with-us
      and /for-companies/hire-graduates — no need to repeat those CTAs here.
    -->
  </div>
</section>

<style>
  /* Contact section uses image-qf10c.jpeg (wave-lines) on live as section bg.
   * Keep transparent here for now — body stars show through. Will swap to the
   * wave-lines asset once we have it as a local asset. */
  section {
    background: transparent;
    text-align: center;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 16px;
  }
  .section-intro {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    max-width: 640px;
    margin: 0 auto 40px;
  }
  .contact-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
  }
  .contact-link[href]:hover,
  .contact-link[href]:focus-visible {
    color: var(--violet);
  }
  .contact-icon {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(149, 84, 255, 0.2);
    border: 1px solid rgba(149, 84, 255, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
</style>
