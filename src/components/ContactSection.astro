---
interface Props {
  id?: string;
}

const { id = 'contact' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section {id}>
  <div class="container">
    <div class="contact-cols">
      <div class="contact-block">
        <h2 class="section-title">Contact</h2>
        <p>Want to learn more about our programmes, partner with us, or hire our graduates? We'd love to hear from you.</p>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">✉</div>
          <a href="mailto:office@everyonecodes.io">office@everyonecodes.io</a>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">📍</div>
          <span>Muthgasse 58/60, 1190 Vienna, Austria</span>
        </div>
      </div>

      <div class="companies-block">
        <h3>Work with us</h3>
        <p>Are you a company looking to partner with us or hire our talented graduates? Let's talk about how we can create value together.</p>
        <div class="btn-group">
          <a href={`${base}/for-companies/work-with-us`} class="btn-outline">Work with us</a>
          <a href={`${base}/for-companies/hire-graduates`} class="btn-outline">Hire our graduates</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: transparent;
  }
  .section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    line-height: 1.2;
    color: var(--white);
    margin-bottom: 24px;
  }
  .contact-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .contact-block p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    margin-bottom: 28px;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    font-size: 14px;
    color: var(--text);
  }
  .contact-item a {
    color: var(--text);
    text-decoration: none;
  }
  .contact-item a:hover {
    color: var(--violet);
  }
  .contact-icon {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(149, 84, 255, 0.2);
    border: 1px solid rgba(149, 84, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .companies-block h3 {
    font-size: 20px;
    color: var(--white);
    margin-bottom: 14px;
  }
  .companies-block p {
    font-size: 14px;
    color: var(--text);
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .btn-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-outline {
    display: inline-block;
    padding: 10px 22px;
    border: 1px solid var(--violet);
    color: var(--violet);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--border-radius);
    transition: background 0.2s, color 0.2s;
  }
  .btn-outline:hover,
  .btn-outline:focus-visible {
    background: var(--violet);
    color: var(--white);
  }
  @media (max-width: 860px) {
    .contact-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
