---
interface Props {
  title: string;
  description: string;
  startDate: string;
  href: string;
  ctaLabel?: string;
}

const { title, description, startDate, href, ctaLabel = 'View →' } = Astro.props;
const titleHtml = title.replace(/\n/g, '<br/>');
---

<article class="programme-card">
  <div class="card-header">
    <h3 set:html={titleHtml}></h3>
  </div>
  <div class="card-content">
    <p>{description}</p>
    <p>No previous knowledge required.</p>
    <div class="card-date">{startDate}</div>
    <a {href} class="btn-card">{ctaLabel}</a>
  </div>
</article>

<style>
  .programme-card {
    max-width: 420px;
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(149, 84, 255, 0.2);
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .programme-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 48px rgba(149, 84, 255, 0.2);
  }
  .card-header {
    background: linear-gradient(135deg, #0d0820 0%, #1c0d3e 50%, #2a1265 100%);
    padding: 28px 28px 24px;
    border-bottom: 1px solid rgba(149, 84, 255, 0.15);
  }
  .card-header h3 {
    font-size: 21px;
    color: var(--white);
    line-height: 1.3;
  }
  .card-content {
    padding: 26px 28px;
  }
  .card-content p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 20px;
  }
  .card-date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--lime);
    background: rgba(218, 255, 84, 0.08);
    border: 1px solid rgba(218, 255, 84, 0.2);
    padding: 6px 14px;
    border-radius: var(--border-radius);
    margin-bottom: 24px;
  }
  .card-date::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    flex-shrink: 0;
  }
  .btn-card {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    background: var(--violet);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.05em;
    border-radius: var(--border-radius);
    transition: background 0.2s;
  }
  .btn-card:hover {
    background: #7e3ee0;
  }
</style>
