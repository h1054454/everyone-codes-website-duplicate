---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import Divider from '~/components/Divider.astro';
import amsWienLogo from '~/assets/associates/ams-wien.png';
import jugendAmWerkLogo from '~/assets/associates/jugend-am-werk.png';
import dodecaIcon from '~/assets/brand/icon-dodecahedron.png';
import offerLearning from '~/assets/offer/learning-experience.webp';
import offerResources from '~/assets/offer/online-resources.webp';
import offerCommunity from '~/assets/offer/alumni-community.webp';
import offerWorkshops from '~/assets/offer/workshops.webp';
import offerCertificate from '~/assets/offer/certificate.webp';

const programme = await getEntry('programmes', 'software-development-vienna');
if (!programme) throw new Error('Programme software-development-vienna not found');

const hf = programme.data.hard_facts;
const apply = programme.data.apply_info;

// FAQs — wording matches live everyonecodes.io exactly (research-phase3 F4
// follow-up after live-Diff check). Hardcoded; small set, rarely changes.
const faqs = [
  {
    q: 'Will I be able to find a job after the programme?',
    a: 'Yes! Upon successful completion of the programme, you will be equipped with all the tools and knowledge necessary to start a career in the field of Software Development.',
  },
  {
    q: 'Do I need any previous experience to participate in the programme?',
    a: "No, don't worry, this programme is for complete beginners. You will learn everything from the very start.",
  },
  {
    q: 'Can I have a full-time or part-time job during the programme?',
    a: 'Unfortunately not. This programme requires an intensive commitment of 32 hours per week. By applying, you are confirming that you are available to attend the programme full-time and in person at our premises in Vienna.',
  },
  {
    q: 'I am not in Vienna! Can I still participate?',
    a: 'Unfortunately not. The programme will be held in Vienna. By applying, you are confirming that you are available to attend the programme full-time and in person at our premises in Vienna.',
  },
  {
    q: 'I am not registered as "unemployed" with AMS Wien. Can I still participate?',
    a: 'Unfortunately not. Only people who are registered as unemployed with AMS Wien are eligible to participate. Details of how to register as unemployed can be found on the AMS Wien website.',
  },
  {
    q: 'How much does the programme cost?',
    a: 'For you? Nothing! — The programme is fully funded by AMS Wien, which means that the costs of the programme are completely covered.',
  },
  {
    q: 'How can I cover my living expenses during the programme?',
    a: 'AMS Wien will generally continue to pay personal compensation during the duration of the programme, depending on your personal eligibility. Details about this can be discussed with your AMS Wien contact person (Berater*in).',
  },
];

const contactSubject = encodeURIComponent('Software Development Vienna — Inquiry');
const contactBody = encodeURIComponent(
  `Hello everyone codes team,

I'm interested in the Software Development Vienna programme.

Name:
Email:
Message:

Best regards,`
);
const contactMailto = `mailto:office@everyonecodes.io?subject=${contactSubject}&body=${contactBody}`;

const infosheetEnMailto = `mailto:office@everyonecodes.io?subject=${encodeURIComponent('Infosheet request (English) — Software Development Vienna')}`;
const infosheetDeMailto = `mailto:office@everyonecodes.io?subject=${encodeURIComponent('Infosheet-Anfrage (Deutsch) — Software Development Vienna')}`;

const mapsUrl = 'https://www.google.com/maps/place/Muthgasse+58,+1190+Wien';
---

<PageLayout
  title="Learn Software Development in Vienna – everyone codes"
  description="Learn everything you'll need to know about Java and back-end development using Spring to start working as a software developer in just 10 months. Fully funded by AMS."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Course • Vienna</span>
      <h1>Learn Software Development</h1>
      <p class="sub-headline">in Vienna</p>
      <p class="lede">
        Learn everything you'll need to know about Java and back-end development using
        Spring to start working as a software developer in just 10 months!
      </p>
      <a href="#about" class="btn-primary">Learn more ↓</a>
    </div>
  </section>

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>Become a Junior Software Developer</h2>
      <p>
        Together with our partner <strong>Jugend am Werk</strong>, we offer this
        10-month full-time programme. The programme is fully funded by
        <strong>AMS Wien</strong> — for eligible participants, there are no costs.
      </p>

      <div class="java-box">
        <h3>Why learn to code?</h3>
        <ul>
          <li>It is fun to learn to code and you can see fast progress.</li>
          <li>There are many companies in Austria looking for people with coding skills.</li>
          <li>Software Development is one of the highest-paying careers in Austria.</li>
          <li>Coding is not just useful for career advancement, it allows you to be creative and work on your own projects. It offers opportunities for limitless improvement and personal development.</li>
          <li>IT is an industry that is in constant growth and will be even more important in the future.</li>
        </ul>
      </div>
    </div>
  </section>

  <Divider />

  <section id="about" class="page-section">
    <div class="inner">
      <h2>About the programme</h2>
      <div class="about-grid">
        <div>
          <h3 class="sub-h">What to expect</h3>
          <ul class="expect-list" style={`--bullet-icon: url(${dodecaIcon.src})`}>
            <li>Learn and truly understand the <strong>Fundamentals of Programming</strong>, important for any language. In addition, you will dive deeper into the specifics of the programming language <strong>Java</strong></li>
            <li>Extending basic knowledge of Java with focus on <strong>back-end specialization</strong></li>
            <li>Learn and truly understand Java frameworks: <strong>Spring Boot</strong> – Web; <strong>Spring Data</strong> – NoSQL, JPA with MySQL; <strong>Spring Security</strong></li>
            <li>Learn how to create and use <strong>databases (SQL)</strong></li>
            <li>Learn about <strong>Docker</strong> and using Docker containers</li>
            <li>Every week: <strong>Lectures</strong>, <strong>Live Coding Sessions</strong>, <strong>Q&amp;A Sessions</strong>, and many <strong>Practical Exercises</strong> to solve with your peers</li>
            <li>Improve and practice the <strong>soft skills</strong> necessary for Junior Software Developers</li>
            <li>The programme will be entirely taught in <strong>English</strong></li>
          </ul>
        </div>

        {hf && (
          <div class="hard-facts">
            <h3>Hard facts</h3>
            <dl>
              <div class="fact-row">
                <dt>Duration</dt>
                <dd>{programme.data.duration}</dd>
              </div>
              {hf.start && (
                <div class="fact-row">
                  <dt>Start</dt>
                  <dd class="lime">{hf.start}</dd>
                </div>
              )}
              {hf.end && (
                <div class="fact-row">
                  <dt>End</dt>
                  <dd>{hf.end}</dd>
                </div>
              )}
              {hf.schedule && hf.schedule.length > 0 && (
                <div class="fact-row">
                  <dt>Schedule</dt>
                  <dd>
                    {hf.schedule.map((line) => <div>{line}</div>)}
                    {hf.hours_per_week && <div>{hf.hours_per_week}</div>}
                  </dd>
                </div>
              )}
              {hf.format && (
                <div class="fact-row">
                  <dt>Format</dt>
                  <dd>{hf.format}</dd>
                </div>
              )}
              {hf.self_study_hours && (
                <div class="fact-row">
                  <dt>Self-study</dt>
                  <dd>{hf.self_study_hours}</dd>
                </div>
              )}
              {hf.language && (
                <div class="fact-row">
                  <dt>Language</dt>
                  <dd>{hf.language}</dd>
                </div>
              )}
              {hf.location && (
                <div class="fact-row">
                  <dt>Location</dt>
                  <dd>{hf.location}</dd>
                </div>
              )}
              {hf.tas_number && (
                <div class="fact-row">
                  <dt>TAS Number</dt>
                  <dd>{hf.tas_number}</dd>
                </div>
              )}
            </dl>
          </div>
        )}
      </div>
    </div>
  </section>

  {apply && (
    <section class="page-section apply-section">
      <div class="apply-box">
        <h2>Interested? Apply via your AMS Advisor now!</h2>
        <ul class="apply-list">
          {apply.info_webinar && (
            <li><strong>Info Webinar:</strong> {apply.info_webinar}</li>
          )}
          {apply.registration_deadline && (
            <li><strong>Registration:</strong> {apply.registration_deadline}</li>
          )}
          {hf?.tas_number && (
            <li>Registration is only possible via your AMS advisor (TAS number <strong>{hf.tas_number}</strong>) — we unfortunately cannot register you directly</li>
          )}
          {apply.mandatory_webinar && (
            <li>Participation in the info webinar is <strong>mandatory</strong> for the application process</li>
          )}
          {apply.mandatory_webinar && (
            <li>You can't apply unless you participated in the info webinar</li>
          )}
        </ul>
      </div>
    </section>
  )}

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>What we offer</h2>
      <div class="offer-grid">
        <div class="offer-card">
          <Image src={offerLearning} alt="" class="offer-icon" width={110} height={110} />
          <h3>A memorable learning experience</h3>
        </div>
        <div class="offer-card">
          <Image src={offerResources} alt="" class="offer-icon" width={110} height={110} />
          <h3>A comprehensive pool of online resources</h3>
        </div>
        <div class="offer-card">
          <Image src={offerCommunity} alt="" class="offer-icon" width={110} height={110} />
          <h3>An alumni programme, intercultural community and regular events</h3>
        </div>
        <div class="offer-card">
          <Image src={offerWorkshops} alt="" class="offer-icon" width={110} height={110} />
          <h3>Workshops and guidance by seasoned programmers and professionals</h3>
        </div>
        <div class="offer-card">
          <Image src={offerCertificate} alt="" class="offer-icon" width={110} height={110} />
          <h3>A certificate as evidence of your hard work, upon successful completion of the programme</h3>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>Eligibility criteria</h2>
      <div class="eligibility-grid">
        <div>
          <h3 class="sub-h">Formal Criteria</h3>
          <ul class="elig-list">
            <li>Need to be registered as "unemployed" at AMS Wien</li>
            <li>Have a valid working permit in Austria</li>
            <li>Be at least 18 years of age by the start of the programme</li>
            <li>English language skills at least on level B2 or equivalent</li>
            <li>Participated in the mandatory info-webinar</li>
            <li>Be available for 32h/week for the duration of the programme</li>
          </ul>
        </div>
        <div>
          <h3 class="sub-h">What else we expect from you</h3>
          <ul class="elig-list">
            <li>Willingness to participate in a full-time programme</li>
            <li>Highly (self-) motivated to learn programming</li>
            <li>Be ready to start working as a (Junior) Software Developer right after the programme</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>Infosheets</h2>
      <p class="infosheet-note">
        Want our 2025 infosheet? Email us and we'll send it back the same day.
      </p>
      <div class="infosheet-row">
        <a href={infosheetEnMailto} class="btn-infosheet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Request Infosheet (English, 2025)
        </a>
        <a href={infosheetDeMailto} class="btn-infosheet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Infosheet anfordern (Deutsch, 2025)
        </a>
      </div>
    </div>
  </section>

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>Our location</h2>
      <a href={mapsUrl} target="_blank" rel="noopener" class="map-card" aria-label="Open Muthgasse 58, 1190 Vienna in Google Maps (opens in new tab)">
        <div class="map-icon" aria-hidden="true">📍</div>
        <div class="map-text">
          <div class="map-address">
            {hf?.location ?? 'Muthgasse 58, 1190 Vienna'}
          </div>
          <div class="map-cta">Open in Maps →</div>
        </div>
      </a>
      <p class="map-note">
        Near U4 Heiligenstadt. Click the card above to open the location in Google Maps
        (external link — no tracking on this page).
      </p>
    </div>
  </section>

  <Divider />

  <section class="page-section">
    <div class="inner">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              {item.q}
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Divider />

  <section class="page-section contact-section" id="contact">
    <div class="inner">
      <h2>Contact us</h2>
      <p>Send us an email with your questions and we'll get back to you.</p>
      <a href={contactMailto} class="btn-primary">Send email</a>
      <p class="contact-direct">
        Or directly: <a href="mailto:office@everyonecodes.io">office@everyonecodes.io</a>
      </p>
    </div>
  </section>

  <section class="associates-section" aria-label="In cooperation with">
    <div class="inner">
      <p class="associates-label">In cooperation with</p>
      <div class="associates-row">
        <Image
          src={amsWienLogo}
          alt="AMS Wien — Arbeitsmarktservice Wien"
          width={220}
          height={126}
          loading="lazy"
        />
        <Image
          src={jugendAmWerkLogo}
          alt="Jugend am Werk"
          width={220}
          height={126}
          loading="lazy"
        />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    text-align: center;
    padding: 100px 24px 60px;
  }
  .container {
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
  }
  .eyebrow {
    display: inline-block;
    background: var(--lime);
    color: var(--bg);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 2px;
    margin-bottom: 20px;
  }
  .page-hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.15;
    color: var(--white);
    margin-bottom: 4px;
  }
  .sub-headline {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(20px, 2.5vw, 28px);
    color: var(--violet);
    margin-bottom: 24px;
  }
  .page-hero .lede {
    font-size: 18px;
    color: var(--text);
    max-width: 640px;
    margin: 0 auto 36px;
    line-height: 1.75;
  }
  .btn-primary {
    display: inline-block;
    padding: 14px 34px;
    background: linear-gradient(90deg, var(--magenta) 0%, var(--violet) 100%);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    border-radius: 999px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover,
  .btn-primary:focus-visible {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .page-section {
    padding: 72px 24px;
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .page-section h2 {
    font-size: clamp(26px, 3.5vw, 40px);
    margin-bottom: 28px;
    color: var(--white);
  }
  .page-section > .inner > p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
    max-width: 760px;
  }
  .sub-h {
    font-size: 18px;
    color: var(--white);
    margin-bottom: 18px;
  }

  .java-box {
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(149, 84, 255, 0.25);
    padding: 28px;
    margin-top: 32px;
  }
  .java-box h3 {
    font-size: 18px;
    color: var(--white);
    margin-bottom: 16px;
  }
  .java-box ul {
    list-style: disc;
    padding-left: 22px;
  }
  .java-box li {
    font-size: 14px;
    line-height: 1.85;
    color: var(--text);
    margin-bottom: 8px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  /* Custom bullet: small dodecahedron logo aligned to the left of each
   * list item. List is fully left-aligned (no list-padding). */
  .expect-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .expect-list li {
    position: relative;
    padding-left: 36px;
    font-size: 14px;
    color: var(--text);
    line-height: 1.75;
  }
  .expect-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    width: 22px;
    height: 22px;
    background-image: var(--bullet-icon);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hard-facts {
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(149, 84, 255, 0.25);
    padding: 28px;
  }
  .hard-facts h3 {
    font-size: 18px;
    color: var(--white);
    margin-bottom: 20px;
  }
  .hard-facts dl {
    margin: 0;
  }
  .fact-row {
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fact-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .fact-row dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact-row dd {
    font-size: 13px;
    color: var(--white);
    line-height: 1.5;
    margin: 0;
  }
  .fact-row dd.lime {
    color: var(--lime);
    font-weight: 600;
  }

  .apply-section {
    padding-top: 0;
  }
  .apply-box {
    background: var(--card);
    border: 1px solid rgba(149, 84, 255, 0.3);
    border-radius: 10px;
    padding: 36px 40px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .apply-box h2 {
    font-size: clamp(20px, 2.5vw, 28px);
    color: var(--white);
    margin-bottom: 20px;
  }
  .apply-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .apply-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--text);
    line-height: 1.65;
  }
  .apply-list li::before {
    content: '▸';
    color: var(--magenta);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .apply-list li strong {
    color: var(--white);
  }

  /* 5 offer cards now (was 4) — fall back to 2-col on small screens */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-top: 12px;
  }
  .offer-card {
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 28px 18px;
    text-align: center;
    transition: border-color 0.2s, transform 0.2s;
  }
  .offer-card:hover {
    border-color: var(--violet);
    transform: translateY(-4px);
  }
  .offer-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 16px;
    display: block;
  }
  .offer-card h3 {
    font-size: 13.5px;
    color: var(--white);
    line-height: 1.4;
  }

  .eligibility-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .elig-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .elig-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--text);
    line-height: 1.65;
  }
  .elig-list li::before {
    content: '▸';
    color: var(--violet);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .infosheet-note {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .infosheet-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn-infosheet {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border: 1px solid rgba(149, 84, 255, 0.4);
    border-radius: 6px;
    color: var(--text);
    font-size: 14px;
    font-family: var(--font-heading);
    font-weight: 600;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-infosheet:hover,
  .btn-infosheet:focus-visible {
    border-color: var(--violet);
    color: var(--white);
  }
  .btn-infosheet svg {
    flex-shrink: 0;
  }

  /* DSGVO-konformer Map-Replacement: static card, no iframe. */
  .map-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 32px;
    background: var(--card);
    border: 1px solid rgba(149, 84, 255, 0.3);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .map-card:hover,
  .map-card:focus-visible {
    border-color: var(--violet);
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(149, 84, 255, 0.18);
  }
  .map-icon {
    font-size: 40px;
    flex-shrink: 0;
  }
  .map-address {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--white);
    margin-bottom: 6px;
  }
  .map-cta {
    color: var(--violet);
    font-size: 14px;
    font-weight: 600;
  }
  .map-note {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
