<style>
  .legal-page {
    padding: 80px 24px;
    min-height: 60vh;
  }
  .container {
    max-width: 720px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    color: var(--white);
    margin-bottom: 40px;
  }
  h2 {
    font-size: clamp(20px, 2.5vw, 26px);
    color: var(--magenta);
    margin: 36px 0 14px;
  }
  .info-block {
    margin-bottom: 20px;
  }
  .info-block dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 12px;
    margin-bottom: 4px;
  }
  .info-block dd {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }
  .info-block dd a {
    color: var(--violet);
  }
  .info-block dd a:hover {
    color: var(--magenta);
    text-decoration: underline;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: rgba(149, 84, 255, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 13px;
  }
  .last-updated {
    margin-top: 56px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 16px;
  }
</style>
