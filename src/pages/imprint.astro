---
import PageLayout from '~/layouts/PageLayout.astro';

// Impressum nach §25 MedienG — auf Deutsch (Entscheidung 2026-06-05), auch
// wenn die übrige Site EN-only ist. Vor dem Cutover (Phase 6) durch Ecovis
// prüfen lassen (insb. Aufsichtsbehörde-Bezeichnung).
---

<PageLayout
  lang="de"
  title="Impressum – everyone codes"
  description="Impressum der everyone codes gGmbH gemäß §25 Mediengesetz — gemeinnützige Bildungs-NGO mit Sitz in Wien."
>
  <section class="legal-page">
    <div class="container">
      <h1>Impressum</h1>

      <p class="lede">
        Angaben gemäß §25 Mediengesetz und §14 Unternehmensgesetzbuch.
      </p>

      <h2>Medieninhaber und Herausgeber</h2>
      <dl class="info-block">
        <dt>Unternehmen</dt>
        <dd>everyone codes gGmbH</dd>
        <dt>Anschrift</dt>
        <dd>
          Muthgasse 58/60<br />
          1190 Wien<br />
          Österreich
        </dd>
      </dl>

      <h2>Kontakt</h2>
      <dl class="info-block">
        <dt>E-Mail</dt>
        <dd><a href="mailto:office@everyonecodes.io">office@everyonecodes.io</a></dd>
        <dt>Telefon</dt>
        <dd><a href="tel:+4368120501739">+43 681 205 017 39</a></dd>
      </dl>

      <h2>Registrierung</h2>
      <dl class="info-block">
        <dt>Firmenbuchnummer</dt>
        <dd>FN 504101a</dd>
        <dt>Umsatzsteuer-Identifikationsnummer</dt>
        <dd>ATU74031102</dd>
        <dt>Kammerzugehörigkeit</dt>
        <dd>Mitglied der Wirtschaftskammer Österreich (WKÖ)</dd>
      </dl>

      <h2>Geschäftsführung</h2>
      <dl class="info-block">
        <dt>Geschäftsführerin</dt>
        <dd>Edina Hadziahmetovic</dd>
      </dl>

      <h2>Unternehmensgegenstand</h2>
      <dl class="info-block">
        <dt>Gegenstand</dt>
        <dd>Gemeinnützige Bildungsarbeit (gemeinnützige GmbH)</dd>
        <dt>Aufsichtsbehörde</dt>
        <dd>Magistratisches Bezirksamt der Stadt Wien</dd>
      </dl>

      <h2>Bankverbindung</h2>
      <dl class="info-block">
        <dt>Bank</dt>
        <dd>Erste Bank Oesterreich</dd>
        <dt>BIC</dt>
        <dd><code>GIBAATWWXXX</code></dd>
        <dt>IBAN</dt>
        <dd><code>AT88 2011 1840 1922 1900</code></dd>
      </dl>

      <h2>Spendenbegünstigung</h2>
      <p>
        Die everyone codes gGmbH ist als begünstigte Spendenempfängerin anerkannt
        (Bescheid des Finanzamts über die Spendenbegünstigung gemäß §4a EStG,
        September 2025). Spenden sind steuerlich absetzbar. Die Eintragung ist in
        der Liste der begünstigten Spendenempfänger des Bundesministeriums für
        Finanzen einsehbar:
      </p>
      <p>
        <a
          href="https://service.bmf.gv.at/service/allg/spenden/show_mast.asp"
          target="_blank"
          rel="noopener"
        >
          Liste der begünstigten Spendenempfänger (BMF)
        </a>
      </p>

      <p class="last-updated">Stand: 5. Juni 2026</p>
    </div>
  </section>
</PageLayout>

<style>
  .legal-page {
    padding: 80px 24px;
    min-height: 60vh;
  }
  .container {
    max-width: 720px;
    margin: 0 auto;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    color: var(--white);
    margin-bottom: 24px;
  }
  .lede {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }
  h2 {
    font-size: clamp(20px, 2.5vw, 26px);
    color: var(--magenta);
    margin: 36px 0 14px;
  }
  .info-block {
    margin-bottom: 20px;
  }
  .info-block dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 12px;
    margin-bottom: 4px;
  }
  .info-block dd {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }
  .info-block dd a,
  p a {
    color: var(--violet);
    text-decoration: underline;
  }
  .info-block dd a:hover,
  p a:hover {
    color: var(--magenta);
  }
  p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 10px;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: rgba(149, 84, 255, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 13px;
  }
  .last-updated {
    margin-top: 56px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 16px;
  }
</style>
