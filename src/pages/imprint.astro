      <dl class="info-block">
        <dt>E-Mail</dt>
        <dd><a href="mailto:office@everyonecodes.io">office@everyonecodes.io</a></dd>
        <dt>Phone</dt>
        <dd><a href="tel:+436812050173">+43 681 205 017 39</a></dd>
      </dl>

