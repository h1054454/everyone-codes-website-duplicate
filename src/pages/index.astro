    headline={'Your career in IT\nstarts here'}
    subtitle="With our high-quality education programmes, we help people start a better professional future in the IT industry."
    ctaLabel="Learn More ↓"
    ctaHref="#mission"
  />
  <Divider />
  <MissionSection />
  <Divider />
  <ProgrammesSection />
  <Divider />
  <LogoCarousel />
  <Divider />
  <TestimonialsSection />
  <Divider />
  <AwardsSection />
  <Divider />
  <TeamSection />
  <CareerCTA />
  <ContactSection />
</PageLayout>
