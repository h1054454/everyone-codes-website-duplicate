---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/Hero.astro';
import Divider from '~/components/Divider.astro';
import MissionSection from '~/components/MissionSection.astro';
import ProgrammesSection from '~/components/ProgrammesSection.astro';
import LogoCarousel from '~/components/LogoCarousel.astro';
import TestimonialsSection from '~/components/TestimonialsSection.astro';
import AwardsSection from '~/components/AwardsSection.astro';
import TeamSection from '~/components/TeamSection.astro';
