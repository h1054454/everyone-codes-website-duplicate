---
import PageLayout from '~/layouts/PageLayout.astro';
import Divider from '~/components/Divider.astro';

// Mentor testimonials are kept hardcoded (research-phase3 F5) — these are
// different people (mentors/POs/SMs) from the alumni testimonials on the
// homepage and they're rarely changed.
const mentorTestimonials = [
  {
    quote:
      'As an alumni I find it important to stay active in this community so I can help the next generation of coders to navigate on their road.',
    initials: 'KH',
    name: 'Krisztina Horvath-Schwarcz',
    role: 'Java Software Engineer @ viesure',
  },
  {
    quote:
      'The best part of the project phase were all these lovely and kind people that I have met.',
    initials: 'DH',
    name: 'Daniel Haumer',
    role: 'Product Owner @ APA-Tech',
  },
  {
    quote: 'I loved being part of something that benefited literally every person involved.',
    initials: 'NB',
    name: 'Noemi-Lenke Bagameri',
    role: 'Scrum Master @ UNIQA',
  },
];

// Partner companies as plain-text boxes (research-phase3 F6) — 1:1 with the
// Duplicate. Sprint B can replace with real logos.
const partners = ['ENIO', 'Timeless Soft', 'ISIS Papyrus', 'APA-Tech', 'viesure', 'UNIQA'];

const collaborationMethods = [
  {
    icon: '🎤',
    title: 'Expert Talk & Workshop',
    text: 'Share your knowledge with our participants. Whether you want to talk about your own IT experience, answer questions during a Q&A session, or design a specific workshop for one of our programmes, we always love to have people from other companies joining our sessions.',
  },
  {
    icon: '💻',
    title: 'Project Week',
    text: 'The final chapter of our journey to become Junior Software Developers is working on individual projects. Six weeks of their time is dedicated to coding whatever a fictional Product Owner wishes for, while being guided by somebody taking on the responsibility of a Scrum Master. Slip into the role of the Product Owner or Scrum Master and create the most realistic learning environment possible.',
  },
  {
    icon: '🤝',
    title: 'Interview Training',
    text: "Practice makes perfect — that's why we also provide our participants with job interview trainings. We invite potential employers to join the training and have mock interviews with our participants. This way you might also meet potential new employees.",
  },
  {
    icon: '🎓',
    title: 'Graduation Ceremony Host',
    text: 'Becoming a fully trained Software Developer or UX Designer is definitely a success worth celebrating. So why not celebrate with us and host a graduation ceremony at your premises? Being part of their success story means being successful yourself.',
  },
  {
    icon: '☕',
    title: 'HR-Brunch',
    text: 'Be our guest — we host a networking event and bring together companies with potential employees.',
  },
  {
    icon: '🌱',
    title: 'Mentoring Programme',
    text: 'Learn from the best — this is the reason why we started the mentoring programme in the first place. So newbies in IT can find guidance by being in contact with people within the field.',
  },
  {
    icon: '🏢',
    title: 'Company Tour',
    text: "If you are not able to join us, we can come to visit you instead and get an insight into your work and learn more about your company, while you give us a showcase of the premises and answer some of our participants' questions.",
  },
];
---

<PageLayout
  title="Work with us – everyone codes"
  description="Be a part of our mission. Help everyone codes train the next generation of IT professionals through expert talks, project weeks, mentoring, and more."
>
  <section class="page-hero">
    <div class="container">
      <h1>Be a part of our mission</h1>
      <p class="lede">
        We educate people for their future in the IT Industry. Help us and make the
        journey even better!
      </p>
      <a href="mailto:office@everyonecodes.io" class="btn-primary">Work with us!</a>
    </div>
  </section>

  <Divider />

  <section class="what-section">
    <div class="container">
      <h2>What we do</h2>
      <p>
        We train the next generation of IT professionals through personalized coaching
        with mentor-created exercises. Community-based learning and realistic project
        simulation distinguish our approach. Join us and help influence the future of
        IT education.
      </p>
      <p class="partners-label">Some of the companies we worked with:</p>
      <div class="partner-logos">
        {partners.map((name) => <div class="partner-logo-box">{name}</div>)}
      </div>
    </div>
  </section>

  <Divider />

  <section class="collab-section">
    <div class="container">
      <h2>How we can work together</h2>
      <div class="collab-grid">
        {collaborationMethods.map((m) => (
          <article class="collab-card">
            <div class="collab-icon" aria-hidden="true">{m.icon}</div>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Divider />

  <section class="testimonials-section">
    <div class="container">
      <h2>What others say about us</h2>
      <div class="testimonials-grid">
        {mentorTestimonials.map((t) => (
          <article class="t-card">
            <blockquote class="t-quote">{t.quote}</blockquote>
            <div class="t-author">
              <div class="t-avatar" aria-hidden="true">{t.initials}</div>
              <div class="t-info">
                <h4>{t.name}</h4>
                <span>{t.role}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Divider />

  <section class="cta-section" id="contact">
    <div class="container">
      <h2>Ready to work with us?</h2>
      <p>
        Get in touch and let's talk about how your company can be part of shaping the
        future of IT education in Austria.
      </p>
      <a href="mailto:office@everyonecodes.io" class="btn-primary">Work with us!</a>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    text-align: center;
    padding: 100px 24px 60px;
  }
  .container {
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
  }
  .page-hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--white);
  }
  .page-hero .lede {
    font-size: 18px;
    color: var(--text);
    max-width: 580px;
    margin: 0 auto 36px;
    line-height: 1.75;
  }
  .btn-primary {
    display: inline-block;
    padding: 14px 34px;
    background: linear-gradient(90deg, var(--magenta) 0%, var(--violet) 100%);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    border-radius: 999px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover,
  .btn-primary:focus-visible {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  section {
    padding: 80px 24px;
  }
  section h2 {
    font-size: clamp(26px, 3.5vw, 40px);
    margin-bottom: 20px;
    color: var(--white);
  }
  .what-section p {
    font-size: 15px;
    color: var(--text);
    line-height: 1.85;
    max-width: 720px;
  }
  .partners-label {
    margin-top: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .partner-logos {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .partner-logo-box {
    background: rgba(149, 84, 255, 0.08);
    border: 1px solid rgba(149, 84, 255, 0.25);
    color: var(--text);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    padding: 10px 22px;
    border-radius: 6px;
  }

  .collab-section {
    background: rgba(0, 0, 0, 0.2);
  }
  .collab-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .collab-card {
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(149, 84, 255, 0.2);
    padding: 28px 26px;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .collab-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(149, 84, 255, 0.18);
  }
  .collab-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }
  .collab-card h3 {
    font-size: 17px;
    color: var(--white);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .collab-card p {
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--text);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .t-card {
    background: var(--card);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .t-quote {
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text);
    flex: 1;
    margin: 0;
  }
  .t-quote::before {
    content: '\201C';
    display: block;
    font-family: var(--font-heading);
    font-size: 52px;
    line-height: 0.7;
    color: var(--violet);
    margin-bottom: 10px;
  }
  .t-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .t-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(149, 84, 255, 0.15);
    border: 2px solid rgba(149, 84, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--white);
    flex-shrink: 0;
  }
  .t-info h4 {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 3px;
  }
  .t-info span {
    font-size: 12px;
    color: var(--violet);
    font-weight: 500;
  }

  .cta-section {
    text-align: center;
  }
  .cta-section p {
    font-size: 15px;
    color: var(--text);
    line-height: 1.8;
    max-width: 580px;
    margin: 0 auto 32px;
  }

  @media (max-width: 860px) {
    .collab-grid,
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
