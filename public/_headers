# Security headers — Cloudflare Pages (Sprint B).
# NOTE: GitHub Pages ignores this file; it only takes effect after the Phase 6
# cutover to Cloudflare. CSP starts permissive enough for the Sveltia CMS
# (loads from unpkg.com, talks to api.github.com + the OAuth worker).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com https://auth.everyonecodes.io
